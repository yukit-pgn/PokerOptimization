{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Joker Poker payout table",
  "type": "object",
  "required": ["name", "highLow", "payouts"],
  "properties": {
    "name": { "type": "string" },
    "description": { "type": "string" },
    "highLow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["winProbabilityByStreak"],
      "properties": {
        "winProbabilityByStreak": {
          "type": "object",
          "additionalProperties": false,
          "required": ["1", "2", "3", "4", "5", "6"],
          "properties": {
            "1": { "type": "number", "minimum": 0, "maximum": 1 },
            "2": { "type": "number", "minimum": 0, "maximum": 1 },
            "3": { "type": "number", "minimum": 0, "maximum": 1 },
            "4": { "type": "number", "minimum": 0, "maximum": 1 },
            "5": { "type": "number", "minimum": 0, "maximum": 1 },
            "6": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "payouts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "five_of_a_kind",
        "royal_flush",
        "straight_flush",
        "four_of_a_kind",
        "full_house",
        "flush",
        "straight",
        "three_of_a_kind",
        "two_pair"
      ],
      "properties": {
        "five_of_a_kind": { "type": "integer", "minimum": 0 },
        "royal_flush": { "type": "integer", "minimum": 0 },
        "straight_flush": { "type": "integer", "minimum": 0 },
        "four_of_a_kind": { "type": "integer", "minimum": 0 },
        "full_house": { "type": "integer", "minimum": 0 },
        "flush": { "type": "integer", "minimum": 0 },
        "straight": { "type": "integer", "minimum": 0 },
        "three_of_a_kind": { "type": "integer", "minimum": 0 },
        "two_pair": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
